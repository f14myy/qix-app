{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Qix",
	"version": "1.2.0",
	"identifier": "ru.qqqix.app",
	"build": {
		"beforeDevCommand": "pnpm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Qix",
				"width": 1320,
				"height": 900,
				"minWidth": 380,
				"minHeight": 560,
				"resizable": true,
				"maximizable": true,
				"center": true,
				"dragDropEnabled": true
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"font-src": "'self' data:",
				"img-src": "'self' data: blob: https:",
				"media-src": "'self' data: blob: https:",
				"connect-src": "'self' https: wss: ipc: http://ipc.localhost",
				"worker-src": "'self' blob:",
				"frame-src": "'none'",
				"object-src": "'none'"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "SocialNetworking",
		"shortDescription": "Light messenger for your privacy",
		"longDescription": "Qix — a light, private messenger. Desktop and Android client for qqqix.ru.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"minSdkVersion": 24
		}
	}
}
