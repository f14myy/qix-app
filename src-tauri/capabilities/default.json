{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capabilities the Qix window needs on every platform",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"opener:default",
		"notification:default",
		"os:default",
		"store:default",
		"dialog:default",
		"fs:default",
		"process:default",
		"deep-link:default",
		"clipboard-manager:allow-write-text",
		"clipboard-manager:allow-read-text"
	]
}
